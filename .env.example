# Environment Variables for Private AI Financial Agent

# ─── AI Provider ───────────────────────────────
# Options: openrouter (default), openai, gemini
AI_PROVIDER=openrouter

# OpenRouter (recommended - access 100+ models)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model to use (default: google/gemini-2.5-flash)
# Popular options:
#   google/gemini-2.5-flash
#   google/gemini-2.5-pro
#   openai/gpt-4o
#   anthropic/claude-sonnet-4
#   meta-llama/llama-4-maverick
OPENROUTER_MODEL=google/gemini-2.5-flash

# OpenAI (if using AI_PROVIDER=openai)
OPENAI_API_KEY=

# Google Gemini (if using AI_PROVIDER=gemini)
GEMINI_API_KEY=

# ─── Flare Network ────────────────────────────
NEXT_PUBLIC_FLARE_TESTNET_RPC=https://coston2-api.flare.network/ext/C/rpc
NEXT_PUBLIC_CHAIN_ID=114
NEXT_PUBLIC_EXPLORER_URL=https://coston2-explorer.flare.network

# ─── Smart Contract ───────────────────────────
# Deployed address on Coston2 (set after deployment)
NEXT_PUBLIC_CONTRACT_ADDRESS=

# ─── Confidential Compute ─────────────────────
# Options: development, flare-fcc
CONFIDENTIAL_MODE=development

# ─── App ───────────────────────────────────────
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
